## Telegram
TELEGRAM_TOKEN=

## OpenAI API key — для текстовой генерации (luna, terra, sol модели)
OPENAI_API_KEY=

## Anthropic (Claude) — необязательно. Финальная проверка сценария после черновика Gemini.
## Без ключа бот работает как раньше.
ANTHROPIC_API_KEY=

## Higgsfield — необязательно. Модели Seedance / Kling / MiniMax через Higgsfield.
## Без ключа эти модели скрыты в меню.
HIGGSFIELD_API_KEY=

## Google Gemini / Vertex AI — для генерации изображений (опционально для текста).
## GEMINI_API_KEY — Developer API key.
## Можно указать VERTEX_API_KEY вместо GEMINI_API_KEY — оба читаются.
## Требуется хотя бы один из OPENAI_API_KEY или GEMINI_API_KEY.
GEMINI_API_KEY=

## Atlas Cloud — Kling v3 Pro, Seedance 2.0, FLUX, Ideogram
ATLAS_API_KEY=

## PostgreSQL — общий с video-gen-bot
CORE_DB_NAME=
DB_USERNAME=
DB_PASSWORD=
DB_HOST=postgres
DB_PORT=5432

## Blotato — публикация в TikTok / YouTube
BLOTATO_BASE_URL=https://backend.blotato.com/v2
BLOTATO_API_KEY=

## ElevenLabs — TTS (накладывается поверх сгенерированного видео)
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=

## Опциональный outro-клип (subscribe video), который добавляется в конец каждого ролика.
## Оставьте пустым, чтобы отключить.
OUTRO_VIDEO_PATH=
